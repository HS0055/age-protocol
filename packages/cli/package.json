{
  "name": "@ageprotocol/cli",
  "version": "0.1.0",
  "description": "agectl, the AGE Protocol command line: verify receipts, manage agent identity",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agectl": "./bin/agectl.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter @ageprotocol/receipts build && pnpm build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ageprotocol/receipts": "workspace:*"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "age",
    "age-protocol",
    "agectl",
    "receipts",
    "verification",
    "ed25519",
    "ai-agents"
  ]
}
